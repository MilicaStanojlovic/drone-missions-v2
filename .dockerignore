# Keep the build context small and avoid leaking local-only/gitignored
# material into image layers. This is a plain filesystem copy, not
# git-aware, so .gitignore does not apply here — everything below has to be
# listed explicitly even though most of it is also gitignored.

# dependencies (installed fresh in the `deps` stage)
node_modules
.pnpm-store

# build output (regenerated by the `builder` stage)
.next
out
*.tsbuildinfo

# env & secrets — never bake real values into an image layer
.env
.env.local
.env.*.local

# tests — not needed to produce the production server bundle
e2e
playwright-report
test-results
coverage

# docker itself
Dockerfile
docker-compose.yml
.dockerignore

# vcs / editor / OS noise
.git
.github
.idea
.vscode
.DS_Store
Thumbs.db
*.log

# per-phase working plans — local planning notes, not app code
plans
