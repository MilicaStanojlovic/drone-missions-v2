# mkdtempSync temp dirs instead of this directory.
drizzle/

# builds & coverage
dist/
coverage/
playwright-report/
test-results/

# env & secrets — never commit real values
.env
.env.local
.env.*.local

# logs & OS noise
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
*.pem

# editor
.idea/
.vscode/

# per-phase working plans (checked-off records stay local)
plans/

# machine-specific Claude Code overrides (agents/ and workflows/ ARE shared)
.claude/settings.local.json
