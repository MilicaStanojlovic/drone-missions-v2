# dependencies
node_modules/
.pnpm-store/
/.pnp
.pnp.*

# next.js
.next/
out/
next-env.d.ts
.vercel

# typescript
*.tsbuildinfo

# drizzle-kit output — Flyway owns the schema, nothing legitimately writes
