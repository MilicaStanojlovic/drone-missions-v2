# This mounted filesystem does not support hardlinks or symlinks, so pnpm's
# default content-addressable store (hardlinks + symlinked virtual store)
# corrupts installs here. `hoisted` gives a flat, mostly-symlink-free
# node_modules; `copy` makes every file an independent copy instead of a
# store hardlink. node_modules/.bin symlinks still fail to be created on
# `pnpm install` in-place — see scripts/README notes for the workaround.
node-linker=hoisted
package-import-method=copy
